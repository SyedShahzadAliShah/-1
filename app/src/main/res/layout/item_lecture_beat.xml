<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:id="@+id/beatRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/beatGlyph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="42sp" />

        <TextView
            android:id="@+id/beatTitleEn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/cinema_on_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/beatTitleUr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/cinema_accent"
            android:textSize="20sp"
            android:textDirection="rtl" />

        <TextView
            android:id="@+id/beatBodyEn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/cinema_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/beatBodyUr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/cinema_on_dark"
            android:textDirection="rtl"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/beatFormula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/cinema_surface"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:textColor="@color/cinema_formula"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
